# ============================================================
# 3TOP Emoji Studio - Environment Variables Sample
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ────────────────────────────────────────
# App
# ────────────────────────────────────────
APP_ENV=development
DEBUG=false

# ────────────────────────────────────────
# Mock Mode (데모/개발용)
# true 로 설정하면 OpenAI/Azure/AWS 없이 UI 체험 가능
# ────────────────────────────────────────
MOCK_MODE=false
NEXT_PUBLIC_MOCK_MODE=false

# ────────────────────────────────────────
# 운영 모드 설정
# AUTH_MODE: password (이메일+비밀번호) | azure (Microsoft SSO)
# IMAGE_PROVIDER: pollinations (무료 AI) | openai (DALL-E 3)
# STORAGE_PROVIDER: minio (로컬 Docker) | s3 (AWS)
# ────────────────────────────────────────
AUTH_MODE=password
IMAGE_PROVIDER=pollinations
STORAGE_PROVIDER=minio
NEXT_PUBLIC_AUTH_MODE=password

# ────────────────────────────────────────
# Database (PostgreSQL)
# ────────────────────────────────────────
POSTGRES_USER=emoji_user
POSTGRES_PASSWORD=strong_password_here
POSTGRES_DB=emoji_studio
DATABASE_URL=postgresql://emoji_user:strong_password_here@postgres:5432/emoji_studio

# ────────────────────────────────────────
# Backend CORS
# ────────────────────────────────────────
# Comma-separated list for production
ALLOWED_ORIGINS=["http://localhost:3000","https://emoji.3top.co.kr"]

# ────────────────────────────────────────
# JWT
# ────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_random_64_char_hex_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ────────────────────────────────────────
# Microsoft Entra ID (Azure AD)
# ────────────────────────────────────────
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_REDIRECT_URI=https://emoji.3top.co.kr/auth/callback

# Frontend public
NEXT_PUBLIC_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_AZURE_REDIRECT_URI=https://emoji.3top.co.kr/auth/callback

# ────────────────────────────────────────
# OpenAI
# ────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=standard

# ────────────────────────────────────────
# MinIO (로컬 S3 대체, STORAGE_PROVIDER=minio 시 사용)
# ────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_BUCKET_NAME=emoji-studio
# MinIO 관리 콘솔: http://localhost:9001

# ────────────────────────────────────────
# AWS S3 (STORAGE_PROVIDER=s3 시 사용)
# ────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=ap-northeast-2
# S3_BUCKET_NAME=3top-emoji-studio-prod
# Optional: CloudFront CDN URL
# S3_BASE_URL=https://cdn.emoji.3top.co.kr

# ────────────────────────────────────────
# Admin
# ────────────────────────────────────────
# 로그인 시 자동으로 관리자 권한을 부여할 이메일 목록 (쉼표 구분)
ADMIN_EMAILS=["admin@3top.co.kr"]

# ────────────────────────────────────────
# Frontend
# ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
